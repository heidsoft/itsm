# ============================================
# ITSM 系统环境变量配置
# ============================================
# 复制此文件为 .env 并根据实际情况修改配置
# cp .env.example .env
# ============================================

# --------------------------------------------
# 数据库配置
# --------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=itsm_user
DB_PASSWORD=                # 必填：生产环境请使用强密码，如 openssl rand -base64 16
DB_NAME=itsm
DB_SSLMODE=disable

# --------------------------------------------
# Redis 配置
# --------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --------------------------------------------
# JWT 认证配置
# --------------------------------------------
JWT_SECRET=                 # Required: generate with: openssl rand -base64 32
JWT_EXPIRE_TIME=900        # 15分钟
JWT_REFRESH_EXPIRE_TIME=604800  # 7天

# --------------------------------------------
# 服务配置
# --------------------------------------------
SERVER_PORT=8090
SERVER_MODE=release        # debug/release/test
GIN_MODE=release           # gin 框架模式
DEPLOYMENT_MODE=private    # private / saas / saas_msp
ITSM_AUTO_MIGRATE=true     # 容器初始化任务使用 true，常驻后端服务使用 false
ITSM_AUTO_SEED=true        # 容器初始化任务使用 true，常驻后端服务使用 false
ITSM_BACKEND_URL=http://localhost:8090  # 前端服务端代理访问后端地址

# --------------------------------------------
# 日志配置
# --------------------------------------------
# 开发环境：debug/info，生产环境：error/warn
LOG_LEVEL=info             # debug/info/warn/error (production: error)
LOG_PATH=./logs

# --------------------------------------------
# 能力就绪申报（/api/v1/capabilities 的 deploymentReady）
# --------------------------------------------
# 有值 = 已就绪（接受 1/true/yes/on）；留空 = 未申报。未申报是 fail-closed，
# 能力矩阵报 deploymentReady=false 并按能力门控隐藏入口，但功能仍可调用——
# 这些变量申报的是「是否对外声称可用」，不是执行开关。
#
# ITSM_CMDB_DISCOVERY_READY: 云资源自动发现与对账。除本项外还需装厂商适配器、
#   配租户凭据解析器与 Worker，并在租户下建一个启用状态的云账号，缺一即未就绪。
# ITSM_FEISHU_READY / ITSM_WECOM_READY / ITSM_DINGTALK_READY: 三方连接器，
#   需先在租户内启用连接器并完成回调验签联调后再申报。
# ITSM_AI_READY: AI 能力（分诊/建议）。triage 走 Guidance sidecar 时同时依赖下面的
#   GUIDANCE_URL 与 AI_SERVICE_TOKEN。
ITSM_CMDB_DISCOVERY_READY=
ITSM_FEISHU_READY=
ITSM_WECOM_READY=
ITSM_DINGTALK_READY=
ITSM_AI_READY=

# --------------------------------------------
# Email-to-Ticket 邮件转工单（首个可收费闭环 · 演示模式）
# --------------------------------------------
# 这三个变量控制"邮件报障 → 自动建工单"的确认行为。
# 默认（全部留空）= 观察模式：会话进入人工确认队列，但不自动建单（fail-closed，安全）。
# 想演示"确认即建单"闭环时，用 docker-compose.demo.yml 一键启用（见 docs/email-intake-demo.md）。
#
# EMAIL_INTAKE_MODE: manualConfirm（人工确认后建单，推荐演示用）/ auto（全自动，需配套可信 RAG 与护栏）
# EMAIL_INTAKE_AUTOMATION_REPORTER_ID: 自动建单时工单的"报告人"系统账号 ID（必须 > 0，否则确认链路报 "reporter not configured"）
# EMAIL_INTAKE_DEFAULT_GROUP_ID: 自动建单归属的默认指派组 ID（可选）
EMAIL_INTAKE_MODE=
EMAIL_INTAKE_AUTOMATION_REPORTER_ID=
EMAIL_INTAKE_DEFAULT_GROUP_ID=

# --------------------------------------------
# LLM 配置 (用于 AI 功能)
# --------------------------------------------
LLM_PROVIDER=openai        # openai/azure/local
LLM_MODEL=gpt-4
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_ENDPOINT=              # 留空使用默认 OpenAI 端点

# --------------------------------------------
# MinIO 对象存储配置
# --------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_CONSOLE_PORT=9001

# --------------------------------------------
# SMS 配置 (短信通知)
# --------------------------------------------
SMS_PROVIDER=              # aliyun/tencent，留空禁用短信

# 阿里云短信配置
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SIGN_NAME=
ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com

# 腾讯云短信配置
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_APP_ID=
TENCENT_SIGN_NAME=
TENCENT_ENDPOINT=sms.tencentcloudapi.com

# --------------------------------------------
# Grafana 监控配置
# （Grafana 管理员密码由 monitoring 堆栈的 GRAFANA_ADMIN_PASSWORD 控制，
#   见 monitoring/docker-compose.monitoring.yml，默认 admin123，生产务必修改）
# --------------------------------------------

# --------------------------------------------
# 前端配置
# --------------------------------------------
NEXT_PUBLIC_API_URL=/api   # 浏览器统一走同源 /api 代理，不直接访问后端容器地址
NODE_ENV=production

# --------------------------------------------
# 开发模式配置
# --------------------------------------------
# 是否启用 Swagger 文档
ENABLE_SWAGGER=true

# 是否启用 CORS
ENABLE_CORS=true
