<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_incident_response" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="incident_response" name="事件响应流程" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="事件发现">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Triage" name="事件分级">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Severity" name="严重程度">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Major</bpmn:outgoing>
      <bpmn:outgoing>Flow_Normal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_MajorResponse" name="重大事件响应">
      <bpmn:incoming>Flow_Major</bpmn:incoming>
      <bpmn:outgoing>Flow_MajorMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AssignResolve" name="分派与解决">
      <bpmn:incoming>Flow_Normal</bpmn:incoming>
      <bpmn:outgoing>Flow_NormalMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_MajorMerge</bpmn:incoming>
      <bpmn:incoming>Flow_NormalMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_Review" name="事件回顾">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Closed" name="事件关闭">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Triage" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Triage" targetRef="Gateway_Severity" />
    <bpmn:sequenceFlow id="Flow_Major" name="重大" sourceRef="Gateway_Severity" targetRef="Task_MajorResponse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${severity == 'critical'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Normal" name="一般" sourceRef="Gateway_Severity" targetRef="Task_AssignResolve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${severity != 'critical'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MajorMerge" sourceRef="Task_MajorResponse" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_NormalMerge" sourceRef="Task_AssignResolve" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_Merge" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Review" targetRef="EndEvent_Closed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="incident_response">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="150" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Triage_di" bpmnElement="Task_Triage">
        <dc:Bounds x="250" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Severity_di" bpmnElement="Gateway_Severity" isMarkerVisible="true">
        <dc:Bounds x="405" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MajorResponse_di" bpmnElement="Task_MajorResponse">
        <dc:Bounds x="520" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AssignResolve_di" bpmnElement="Task_AssignResolve">
        <dc:Bounds x="520" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge">
        <dc:Bounds x="685" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review">
        <dc:Bounds x="800" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Closed_di" bpmnElement="EndEvent_Closed">
        <dc:Bounds x="962" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="186" y="218" />
        <di:waypoint x="250" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="350" y="218" />
        <di:waypoint x="405" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Major_di" bpmnElement="Flow_Major">
        <di:waypoint x="430" y="195" />
        <di:waypoint x="430" y="140" />
        <di:waypoint x="520" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Normal_di" bpmnElement="Flow_Normal">
        <di:waypoint x="430" y="245" />
        <di:waypoint x="430" y="300" />
        <di:waypoint x="520" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MajorMerge_di" bpmnElement="Flow_MajorMerge">
        <di:waypoint x="620" y="140" />
        <di:waypoint x="710" y="140" />
        <di:waypoint x="710" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NormalMerge_di" bpmnElement="Flow_NormalMerge">
        <di:waypoint x="620" y="300" />
        <di:waypoint x="710" y="300" />
        <di:waypoint x="710" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="735" y="220" />
        <di:waypoint x="800" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="900" y="218" />
        <di:waypoint x="962" y="218" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
