# syntax=docker/dockerfile:1.7
#
# ITSM Backend — production image (multi-stage)
#
# Optimizations:
#   - Pinned base images (golang:1.25.13-alpine, alpine:3.20)
#   - BuildKit cache mounts for go modules + build cache
#   - Cross-platform build via TARGETOS/TARGETARCH
#   - trimpath + "-s -w" to strip debug info and shrink the binary
#   - Memory guards (GOGC/GOMEMLIMIT) kept for large ent packages
#   - Static, non-root runtime on alpine:3.20
#   - Parallel module download and build cache warming
#   - Optimized layer caching with .dockerignore

# ============================================================
# Stage 1: Build
# ============================================================
FROM --platform=$BUILDPLATFORM mirror.gcr.io/library/golang:1.25.13-alpine AS builder

WORKDIR /src

ARG TARGETOS=linux
ARG TARGETARCH=amd64
# Default to the China mirror; overseas CI can override:
#   --build-arg GOPROXY=https://proxy.golang.org,direct
ARG GOPROXY=https://goproxy.cn,direct
ARG GOSUMDB=sum.golang.org

ENV CGO_ENABLED=0 \
    GOOS=${TARGETOS} \
    GOARCH=${TARGETARCH} \
    GOPROXY=${GOPROXY} \
    GOSUMDB=${GOSUMDB} \
    GOFLAGS="-p=2 -trimpath" \
    GOMAXPROCS=2 \
    GOGC=50 \
    GOMEMLIMIT=2GiB

RUN apk add --no-cache ca-certificates git bash

# Copy go.mod and go.sum first for better layer caching
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download

# Copy source code
COPY . .

# Build main binary with optimized flags
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build \
    -trimpath \
    -ldflags="-s -w -X main.version=${VERSION:-dev} -X main.buildTime=$(date -u +%Y%m%d%H%M%S)" \
    -o /out/main \
    ./main.go

# Build migration tool
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build \
    -trimpath \
    -ldflags="-s -w" \
    -tags migrate \
    -o /out/migrate-tool \
    ./cmd/migrate/main.go

# ============================================================
# Stage 2: Runtime (alpine — minimal, non-root)
# ============================================================
FROM mirror.gcr.io/library/alpine:3.20 AS runtime

WORKDIR /app

# Install runtime dependencies in a single layer
RUN apk add --no-cache \
    ca-certificates \
    curl \
    tzdata \
    && addgroup -S app \
    && adduser -S -G app app \
    && mkdir -p /app/logs /app/uploads /app/temp \
    && chown -R app:app /app

# Copy binaries and config files
COPY --from=builder --chown=app:app /out/main ./main
COPY --from=builder --chown=app:app /out/migrate-tool ./migrate-tool
COPY --chown=app:app config.yaml ./
COPY --chown=app:app migrations ./migrations
COPY --chown=app:app config/seed ./config/seed
COPY --chown=app:app docs/swagger.json ./docs/
COPY --chown=app:app docs/swagger.yaml ./docs/

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8090/api/v1/health || exit 1

USER app
CMD ["./main"]
