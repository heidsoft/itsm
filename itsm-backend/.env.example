# ITSM 环境配置
# ===========================================
# 开发环境：使用 trust 认证，无需设置密码
# 生产环境：请务必设置强密码！

# 数据库配置（必需）
DB_PASSWORD=

# JWT 密钥（必需）
JWT_SECRET=

# ===========================================
# 生产环境建议使用随机生成器创建密码，例如：
# JWT_SECRET=$(openssl rand -base64 32)
# DB_PASSWORD=$(openssl rand -base64 16)
# ===========================================

# ===========================================
# 变更管理（可选）
# ===========================================
# 标准变更低风险自动免审（默认 false，合规部署保持关闭）
# 开启后：标准变更 + 低风险 + 有实施/回滚计划 -> 直接 APPROVED，跳过审批
# 注意：风险等级由创建人自报，政务/医疗等强合规场景请勿开启
# ENABLE_STANDARD_CHANGE_AUTO_APPROVE=false
