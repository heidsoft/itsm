<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:itsm="https://github.com/heidsoft/itsm/schema/bpmn"
                 targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="service_request_flow" name="Service Request Workflow" isExecutable="true">
    <bpmn:extensionElements>
      <bpmn:metaData name="category">service_request</bpmn:metaData>
      <bpmn:metaData name="version">2.1.0</bpmn:metaData>
      <bpmn:metaData name="description">Standard service request workflow with approval levels and approvers determined by process variables</bpmn:metaData>
    </bpmn:extensionElements>

    <bpmn:startEvent id="StartEvent_1" name="Submit Request">
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 提交即受理：受理不再是一个用户任务，否则审批桥接会把「受理」当成审批待办。 -->
    <bpmn:exclusiveGateway id="Gateway_Approval" name="Approval Required?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 一级审批：审批人与会签阈值来自 approval_plan 变量。 -->
    <bpmn:userTask id="Activity_Approval_L1" name="Level 1 Approval"
                   itsm:taskPurpose="approval" itsm:approvalLevel="1"
                   itsm:approvalMode="single" itsm:commentRequiredOnReject="true">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_L1_Result</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_L1_Result" name="Level 1 Approval Result?">
      <bpmn:incoming>Flow_L1_Result</bpmn:incoming>
      <bpmn:outgoing>Flow_L1_Pass_Next</bpmn:outgoing>
      <bpmn:outgoing>Flow_L1_Pass_Last</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Activity_Approval_L2" name="Level 2 Approval"
                   itsm:taskPurpose="approval" itsm:approvalLevel="2"
                   itsm:approvalMode="single" itsm:commentRequiredOnReject="true">
      <bpmn:incoming>Flow_L1_Pass_Next</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_Result</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_L2_Result" name="Level 2 Approval Result?">
      <bpmn:incoming>Flow_L2_Result</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_Pass_Next</bpmn:outgoing>
      <bpmn:outgoing>Flow_L2_Pass_Last</bpmn:outgoing>
      <bpmn:outgoing>Flow_L2_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Activity_Approval_L3" name="Level 3 Approval"
                   itsm:taskPurpose="approval" itsm:approvalLevel="3"
                   itsm:approvalMode="single" itsm:commentRequiredOnReject="true">
      <bpmn:incoming>Flow_L2_Pass_Next</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_Result</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_L3_Result" name="Level 3 Approval Result?">
      <bpmn:incoming>Flow_L3_Result</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_L3_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Activity_RejectNotify" name="Rejection Notification" implementation="##WebService">
      <bpmn:extensionElements>
        <bpmn:metaData name="service_task_type">generic_task</bpmn:metaData>
        <bpmn:metaData name="action">notify_rejection</bpmn:metaData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_L2_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_L3_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_EndReject</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Activity_Execute" name="Fulfill Service" itsm:taskPurpose="work">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_L1_Pass_Last</bpmn:incoming>
      <bpmn:incoming>Flow_L2_Pass_Last</bpmn:incoming>
      <bpmn:incoming>Flow_L3_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Activity_Confirm" name="User Confirmation" itsm:taskPurpose="work">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Satisfaction" name="Satisfied?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_Feedback</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Activity_Feedback" name="Improve Service" itsm:taskPurpose="work">
      <bpmn:incoming>Flow_Feedback</bpmn:incoming>
      <bpmn:outgoing>Flow_FeedbackLoop</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Activity_Complete" name="Service Completed" implementation="##WebService">
      <bpmn:extensionElements>
        <bpmn:metaData name="service_task_type">generic_task</bpmn:metaData>
        <bpmn:metaData name="action">complete_service</bpmn:metaData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_1" name="Workflow Ended">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Reject" name="Request Rejected">
      <bpmn:incoming>Flow_EndReject</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_2" sourceRef="StartEvent_1" targetRef="Gateway_Approval" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_Approval" targetRef="Activity_Approval_L1">
      <bpmn:conditionExpression><![CDATA[${variables['need_approval'] == true}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_Approval" targetRef="Activity_Execute">
      <bpmn:conditionExpression><![CDATA[${variables['need_approval'] != true}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_L1_Result" sourceRef="Activity_Approval_L1" targetRef="Gateway_L1_Result" />
    <!-- 审批链只有一级时直接进入执行；只有存在第 2 级才创建二级审批待办。 -->
    <bpmn:sequenceFlow id="Flow_L1_Pass_Next" sourceRef="Gateway_L1_Result" targetRef="Activity_Approval_L2">
      <bpmn:conditionExpression><![CDATA[${variables['approvalResult'] == 'approved' && variables['total_levels'] >= 2}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_L1_Pass_Last" sourceRef="Gateway_L1_Result" targetRef="Activity_Execute">
      <bpmn:conditionExpression><![CDATA[${variables['approvalResult'] == 'approved' && variables['total_levels'] < 2}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_L2_Result" sourceRef="Activity_Approval_L2" targetRef="Gateway_L2_Result" />
    <bpmn:sequenceFlow id="Flow_L2_Pass_Next" sourceRef="Gateway_L2_Result" targetRef="Activity_Approval_L3">
      <bpmn:conditionExpression><![CDATA[${variables['approvalResult'] == 'approved' && variables['total_levels'] >= 3}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_L2_Pass_Last" sourceRef="Gateway_L2_Result" targetRef="Activity_Execute">
      <bpmn:conditionExpression><![CDATA[${variables['approvalResult'] == 'approved' && variables['total_levels'] < 3}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_L3_Result" sourceRef="Activity_Approval_L3" targetRef="Gateway_L3_Result" />
    <bpmn:sequenceFlow id="Flow_L3_Pass" sourceRef="Gateway_L3_Result" targetRef="Activity_Execute">
      <bpmn:conditionExpression><![CDATA[${variables['approvalResult'] == 'approved'}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Reject" sourceRef="Gateway_L1_Result" targetRef="Activity_RejectNotify">
      <bpmn:conditionExpression><![CDATA[${variables['approvalResult'] == 'rejected'}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_L2_Reject" sourceRef="Gateway_L2_Result" targetRef="Activity_RejectNotify">
      <bpmn:conditionExpression><![CDATA[${variables['approvalResult'] == 'rejected'}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_L3_Reject" sourceRef="Gateway_L3_Result" targetRef="Activity_RejectNotify">
      <bpmn:conditionExpression><![CDATA[${variables['approvalResult'] == 'rejected'}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_EndReject" sourceRef="Activity_RejectNotify" targetRef="EndEvent_Reject" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Execute" targetRef="Activity_Confirm" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_Confirm" targetRef="Gateway_Satisfaction" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Satisfaction" targetRef="Activity_Complete">
      <bpmn:conditionExpression><![CDATA[${variables['satisfied'] == true}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Feedback" sourceRef="Gateway_Satisfaction" targetRef="Activity_Feedback">
      <bpmn:conditionExpression><![CDATA[${variables['satisfied'] != true}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FeedbackLoop" sourceRef="Activity_Feedback" targetRef="Activity_Confirm" />
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Activity_Complete" targetRef="EndEvent_1" />
  </bpmn:process>
</bpmn:definitions>
