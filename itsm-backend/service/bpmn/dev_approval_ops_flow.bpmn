<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 targetNamespace="http://bpmn.io/schema/bpmn"
                 id="Definitions_1">

  <bpmn:process id="dev_approval_ops_flow" name="开发审批运维流程" isExecutable="true">
    <bpmn:extensionElements>
      <bpmn:metaData name="category">ticket</bpmn:metaData>
      <bpmn:metaData name="version">1.0.0</bpmn:metaData>
      <bpmn:metaData name="description">开发提交→主管审批→运维操作三级流程</bpmn:metaData>
    </bpmn:extensionElements>

    <!-- 开始事件 -->
    <bpmn:startEvent id="StartEvent_1" name="流程开始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 开发提交 -->
    <bpmn:userTask id="Activity_DevSubmit" name="开发提交">
      <bpmn:extensionElements>
        <bpmn:metaData name="service_task_type">ticket_task</bpmn:metaData>
        <bpmn:metaData name="action">dev_submit</bpmn:metaData>
        <bpmn:metaData name="assignee_type">developer</bpmn:metaData>
        <bpmn:metaData name="timeout_hours">24</bpmn:metaData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 主管审批 -->
    <bpmn:userTask id="Activity_ManagerApproval" name="主管审批">
      <bpmn:extensionElements>
        <bpmn:metaData name="service_task_type">ticket_task</bpmn:metaData>
        <bpmn:metaData name="action">manager_approval</bpmn:metaData>
        <bpmn:metaData name="assignee_type">manager</bpmn:metaData>
        <bpmn:metaData name="timeout_hours">8</bpmn:metaData>
        <bpmn:metaData name="approval_required">true</bpmn:metaData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 审批结果网关 -->
    <bpmn:exclusiveGateway id="Gateway_ApprovalResult" name="审批结果">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 运维操作 -->
    <bpmn:userTask id="Activity_OpsExecute" name="运维操作">
      <bpmn:extensionElements>
        <bpmn:metaData name="service_task_type">ticket_task</bpmn:metaData>
        <bpmn:metaData name="action">ops_execute</bpmn:metaData>
        <bpmn:metaData name="assignee_type">ops_engineer</bpmn:metaData>
        <bpmn:metaData name="timeout_hours">16</bpmn:metaData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 驳回到开发 -->
    <bpmn:userTask id="Activity_DevRework" name="开发修改">
      <bpmn:extensionElements>
        <bpmn:metaData name="service_task_type">ticket_task</bpmn:metaData>
        <bpmn:metaData name="action">dev_rework</bpmn:metaData>
        <bpmn:metaData name="assignee_type">developer</bpmn:metaData>
        <bpmn:metaData name="timeout_hours">24</bpmn:metaData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_Rework</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 结束事件 -->
    <bpmn:endEvent id="EndEvent_1" name="流程结束">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 连线定义 -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_DevSubmit" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_DevSubmit" targetRef="Activity_ManagerApproval" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_ManagerApproval" targetRef="Gateway_ApprovalResult" />
    <bpmn:sequenceFlow id="Flow_Approved" sourceRef="Gateway_ApprovalResult" targetRef="Activity_OpsExecute">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:body>${variables['approved'] == true}</bpmn:body>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" sourceRef="Gateway_ApprovalResult" targetRef="Activity_DevRework">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:body>${variables['approved'] != true}</bpmn:body>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rework" sourceRef="Activity_DevRework" targetRef="Activity_ManagerApproval" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_OpsExecute" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="dev_approval_ops_flow">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="142" y="275" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_DevSubmit_di" bpmnElement="Activity_DevSubmit">
        <dc:Bounds x="240" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_ManagerApproval_di" bpmnElement="Activity_ManagerApproval">
        <dc:Bounds x="390" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ApprovalResult_di" bpmnElement="Gateway_ApprovalResult" isMarkerVisible="true">
        <dc:Bounds x="545" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="538" y="285" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_OpsExecute_di" bpmnElement="Activity_OpsExecute">
        <dc:Bounds x="650" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_DevRework_di" bpmnElement="Activity_DevRework">
        <dc:Bounds x="520" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="802" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="792" y="275" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="250" />
        <di:waypoint x="240" y="250" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="250" />
        <di:waypoint x="390" y="250" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="490" y="250" />
        <di:waypoint x="545" y="250" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="595" y="250" />
        <di:waypoint x="650" y="250" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="570" y="225" />
        <di:waypoint x="570" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Rework_di" bpmnElement="Flow_Rework">
        <di:waypoint x="520" y="120" />
        <di:waypoint x="440" y="120" />
        <di:waypoint x="440" y="210" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="750" y="250" />
        <di:waypoint x="802" y="250" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
