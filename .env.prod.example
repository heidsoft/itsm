# ============================================
# ITSM Production Environment Configuration
# ============================================
# Copy this file to .env.prod and fill in ALL values:
#   cp .env.prod.example .env.prod
#
# SECURITY: Never commit .env.prod to version control.
#           All values marked [REQUIRED] must be set.
# ============================================

# Immutable application/image version [REQUIRED]
# Use a tested release tag or digest-aligned version; never use "latest".
VERSION=1.6.60

# --------------------------------------------
# Database [REQUIRED]
# --------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=itsm
DB_PASSWORD=                 # [REQUIRED] Use a strong password (32+ chars)
DB_NAME=itsm_prod
DB_SSLMODE=disable           # Internal Compose DB only; use "verify-full" for an external production DB

# --------------------------------------------
# Redis [REQUIRED]
# --------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=              # [REQUIRED] Use a strong password
REDIS_DB=0

# --------------------------------------------
# JWT Authentication [REQUIRED]
# --------------------------------------------
JWT_SECRET=                  # [REQUIRED] Minimum 32 characters, use a random string
                              # Generate: openssl rand -base64 48
JWT_EXPIRE_TIME=86400        # Access token: 24 hours
JWT_REFRESH_EXPIRE_TIME=604800  # Refresh token: 7 days

# --------------------------------------------
# Admin Account
# --------------------------------------------
ADMIN_PASSWORD=              # [REQUIRED] Strong password for admin account

# --------------------------------------------
# Server Configuration
# --------------------------------------------
SERVER_PORT=8090
SERVER_ENV=production
GIN_MODE=release
BACKEND_DIAG_PORT=8090     # 宿主机诊断端口（仅绑定 127.0.0.1）；与 dev 栈同机运行时改为 8091 避免端口争用
DEPLOYMENT_MODE=saas       # private / saas / saas_msp
ITSM_AUTO_MIGRATE=false    # 生产常驻后端建议关闭，由 itsm-init 一次性执行
ITSM_AUTO_SEED=false       # 生产常驻后端建议关闭，由 itsm-init 一次性执行
LOG_LEVEL=error              # debug/info/warn/error
LOG_FORMAT=json              # json for structured logging in production
LOG_PATH=/app/logs

# --------------------------------------------
# MinIO Object Storage [OPTIONAL - not started by default]
#
# The backend (Go) and frontend currently do not use MinIO/S3 at all; the
# service is defined in docker-compose.prod.yml under the "storage" profile and
# is NOT started by a normal deployment. You can leave these empty.
#
# To actually run it:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml --profile storage up -d minio
# --------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=            # [OPTIONAL] only needed with --profile storage
MINIO_SECRET_KEY=            # [OPTIONAL] only needed with --profile storage
MINIO_BUCKET=itsm-uploads
MINIO_USE_SSL=false

# --------------------------------------------
# LLM Configuration (AI Features)
# --------------------------------------------
LLM_PROVIDER=openai          # openai/azure/local/minimax
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=              # Required if LLM_PROVIDER=openai
OPENAI_BASE_URL=             # Optional: custom endpoint

# --------------------------------------------
# AI Service-to-Service Tokens (REQUIRED since 2026-11-17)
# --------------------------------------------
# Sidecar 已 fail-closed：缺令牌时除 /health 外全部 401，AI 分诊不可用。
# AI_SERVICE_TOKEN 在 backend 与 itsm-ai-service 两侧必须同值。
# 生成建议：openssl rand -hex 32
AI_SERVICE_TOKEN=            # [REQUIRED] X-Service-Token shared by backend & ai-service
# ITSM_BACKEND_TOKEN 是 ai-service 回连 Go 后端的凭证，必须是 service JWT（不是随机串！）。
# 随机串会被后端 AuthMiddleware 以 JWT 解析失败拒绝 → 回连 401 → sidecar 静默降级到规则分诊。
# 签发（tenant-id 填 sidecar 被允许访问的固定租户，ttl 建议 8760h=1年）：
#   ITSM_BACKEND_TOKEN=$(JWT_SECRET="$JWT_SECRET" go run ./itsm-backend/cmd/service-token-gen -tenant-id 1 -ttl 8760h)
# token 带签名保护的 principal=service + 只读角色，后端据此注入零信任主体并留痕。
ITSM_BACKEND_TOKEN=          # [REQUIRED] signed service JWT for ai-service -> backend callbacks
# AI_SERVICE_AUTH_MODE=disabled  # [DEV ONLY] 本地开发显式降级为无鉴权；生产禁止

# --------------------------------------------
# CORS Configuration
# --------------------------------------------
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# --------------------------------------------
# Email Notifications (SMTP)
# --------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# --------------------------------------------
# DingTalk Notifications
# --------------------------------------------
DINGTALK_WEBHOOK=

# --------------------------------------------
# WeCom Notifications
# --------------------------------------------
WECOM_WEBHOOK=

# --------------------------------------------
# Frontend Configuration
# --------------------------------------------
# Keep empty for the standard Nginx deployment. API clients already use
# /api/v1/* paths, so setting this to /api would produce /api/api/v1/*.
NEXT_PUBLIC_API_URL=
ITSM_BACKEND_URL=http://itsm-backend:8090
NEXT_PUBLIC_ENABLE_AI=true

# --------------------------------------------
# Monitoring (opt-in via "monitoring" profile)
# --------------------------------------------
# The monitoring stack (Prometheus + Alertmanager + Grafana + exporters) is not
# started by default. Enable it with:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml --profile monitoring up -d
#
# When the monitoring profile is active:
# 1. Keep METRICS_REQUIRE_AUTH=true. Prometheus can scrape /metrics with a
#    service JWT; do not disable authentication on the default template.
#    Only set it to false on an isolated deployment where the backend port is
#    not reachable by untrusted users, and record that decision in the
#    deployment record.
# 2. Set GRAFANA_ADMIN_PASSWORD to a strong password (required).
#
# Monitoring ports (all localhost-only, access via SSH tunnel or reverse proxy):
#   - Prometheus:   127.0.0.1:9090
#   - Alertmanager: 127.0.0.1:9093
#   - Grafana:      127.0.0.1:3001
METRICS_REQUIRE_AUTH=true          # Set to false only on an isolated monitoring deployment
GRAFANA_ADMIN_PASSWORD=            # [REQUIRED when monitoring profile is active] Strong password

# --------------------------------------------
# TLS Configuration
# --------------------------------------------
# This Compose stack exposes HTTP on port 80 for an enterprise ingress/load
# balancer. TLS must terminate at that trusted ingress; do not expose port 80
# directly to untrusted networks.
