# ============================================
# ITSM 开发环境变量配置
# ⚠️ 仅用于本地开发，勿用于生产环境！
# ============================================
# 复制此文件为 .env 进行开发
# cp .env.dev.example .env
# ============================================

# --------------------------------------------
# Docker 镜像与 Windows Docker Desktop 加速
# --------------------------------------------
# Compose 会自动读取项目根目录的 .env。Redis/MinIO 默认使用 DaoCloud
# Docker Hub 代理；下面列出全部外部运行时镜像，取消注释即可按需覆盖。
# POSTGRES_IMAGE=pgvector/pgvector:pg17
# REDIS_IMAGE=m.daocloud.io/docker.io/library/redis:7-alpine
# MINIO_IMAGE=m.daocloud.io/docker.io/minio/minio:latest
# OLLAMA_IMAGE=ollama/ollama:latest
# PROMETHEUS_IMAGE=prom/prometheus:latest
# GRAFANA_IMAGE=grafana/grafana:10.1.0
#
# 如需切回 Docker Hub 官方短名称：
# REDIS_IMAGE=redis:7-alpine
# MINIO_IMAGE=minio/minio:latest
#
# Windows Docker Desktop 还可打开 Settings -> Docker Engine，将以下字段
# 合并进现有 daemon JSON（不要覆盖已有配置），然后 Apply & restart：
#   "registry-mirrors": ["https://docker.m.daocloud.io"]
# 验证：docker info（查看 Registry Mirrors）
# 拉取：docker compose -f docker-compose.dev.yml pull
# 注意：registry-mirrors 是 daemon 配置，不能作为 docker-compose.yml 顶层字段。

# --------------------------------------------
# 数据库配置 (开发环境)
# --------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=itsm_user
DB_PASSWORD=dev123
DB_NAME=itsm
DB_SSLMODE=disable

# --------------------------------------------
# Redis 配置 (开发环境)
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --------------------------------------------
# JWT 认证配置 (开发环境)
# --------------------------------------------
JWT_SECRET=dev-secret-key-change-in-production-minimum-32-characters-long
JWT_EXPIRE_TIME=900        # 15分钟
JWT_REFRESH_EXPIRE_TIME=604800  # 7天

# --------------------------------------------
# 服务配置 (开发环境)
# --------------------------------------------
SERVER_PORT=8090
SERVER_MODE=debug          # debug/release/test
GIN_MODE=debug             # gin 框架模式
DEPLOYMENT_MODE=private    # private / saas / saas_msp
ITSM_AUTO_MIGRATE=false    # 开发时建议 false，避免重复执行迁移
ITSM_AUTO_SEED=false       # 开发时建议 false，避免重复执行数据填充
ITSM_BACKEND_URL=http://localhost:8090  # 前端服务端代理访问后端地址

# --------------------------------------------
# 日志配置 (开发环境)
# --------------------------------------------
LOG_LEVEL=debug            # debug/info/warn/error (生产环境使用 error/warn)
LOG_PATH=./logs

# --------------------------------------------
# LLM 配置 (用于 AI 功能)
# --------------------------------------------
LLM_PROVIDER=openai        # openai/azure/local
LLM_MODEL=gpt-4
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_ENDPOINT=              # 留空使用默认 OpenAI 端点

# --------------------------------------------
# MinIO 对象存储配置 (开发环境)
# --------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_CONSOLE_PORT=9001

# --------------------------------------------
# SMS 配置 (短信通知) - 开发环境建议留空
# --------------------------------------------
SMS_PROVIDER=              # aliyun/tencent，留空禁用短信

# 阿里云短信配置
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SIGN_NAME=
ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com

# 腾讯云短信配置
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_APP_ID=
TENCENT_SIGN_NAME=
TENCENT_ENDPOINT=sms.tencentcloudapi.com

# --------------------------------------------
# Grafana 监控配置 (开发环境)
# （Grafana 管理员密码由 monitoring 堆栈的 GRAFANA_ADMIN_PASSWORD 控制，
#   见 monitoring/docker-compose.monitoring.yml，默认 admin123）
# --------------------------------------------

# --------------------------------------------
# 前端配置 (开发环境)
# --------------------------------------------
NEXT_PUBLIC_API_URL=/api   # 浏览器统一走同源 /api 代理，不直接访问后端容器地址
NODE_ENV=development       # development/production

# --------------------------------------------
# 开发模式配置
# --------------------------------------------
# 是否启用 Swagger 文档
ENABLE_SWAGGER=true

# 是否启用 CORS
ENABLE_CORS=true
