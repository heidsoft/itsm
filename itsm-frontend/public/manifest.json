{
  "name": "ITSM Intelligent Service Management System",
  "short_name": "ITSM",
  "description": "AI-based intelligent IT service management system, providing core functions such as work order management, incident management, problem management, and change management.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#1890ff",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en-US",
  "dir": "ltr",
  "categories": [
    "productivity",
    "business",
    "utilities"
  ],
  "icons": [
    {
      "src": "/file.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/window.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Ticket Management",
      "short_name": "Ticket",
      "description": "Quick access to work order management functions",
      "url": "/tickets",
      "icons": [
        {
          "src": "/file.svg",
          "sizes": "any"
        }
      ]
    },
    {
      "name": "Incidents",
      "short_name": "Incident",
      "description": "Quick access to event management functions",
      "url": "/incidents",
      "icons": [
        {
          "src": "/file.svg",
          "sizes": "any"
        }
      ]
    },
    {
      "name": "Problems",
      "short_name": "Problem",
      "description": "Quick access to problem management features",
      "url": "/problems",
      "icons": [
        {
          "src": "/file.svg",
          "sizes": "any"
        }
      ]
    },
    {
      "name": "Changes",
      "short_name": "Change",
      "description": "Quick access to change management capabilities",
      "url": "/changes",
      "icons": [
        {
          "src": "/file.svg",
          "sizes": "any"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://itsm.example.com/manifest.json"
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred",
  "protocol_handlers": [
    {
      "protocol": "web+itsm",
      "url": "/tickets?id=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/upload",
      "accept": {
        "text/csv": [
          ".csv"
        ],
        "application/vnd.ms-excel": [
          ".xls"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            "text/*",
            "application/pdf"
          ]
        }
      ]
    }
  }
}
