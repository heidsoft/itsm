# =============================================================================
# ITSM SaaS 部署环境变量模板
# 复制为 deploy/.env.saas 并填写（该文件含密钥，切勿提交进 git）。
# 启动：docker compose --env-file deploy/.env.saas -f deploy/docker-compose.saas.yml up -d
# =============================================================================

# ---- 对外域名与证书（Caddy 自动签发 Let's Encrypt）----
# 公网域名需已解析 A 记录到本机 ECS 公网 IP，且 80/443 入站放通。
SAAS_DOMAIN=itsm.example.com
# Let's Encrypt 注册邮箱（也是证书到期提醒邮箱）
ACME_EMAIL=admin@example.com

# ---- 镜像来源 ----
# 本地构建：留空。从阿里云 ACR 拉取：填完整命名空间前缀，例如
# REGISTRY=registry.cn-hangzhou.aliyuncs.com/heidsoft/
REGISTRY=
# 必须与所构建/拉取的镜像 tag 一致（API / 镜像 / 发布版本三位一体）
VERSION=v1.6.58

# ---- 部署形态：单实例多租户 ----
DEPLOYMENT_MODE=saas

# ---- 数据库 ----
DB_NAME=itsm_prod
DB_USER=itsm
DB_PASSWORD=__CHANGE_ME_strong_db_password__
DB_SSLMODE=disable

# ---- Redis ----
REDIS_PASSWORD=__CHANGE_ME_strong_redis_password__

# ---- JWT ----
# 推荐：openssl rand -hex 32
JWT_SECRET=__CHANGE_ME_64_hex_chars_jwt_secret__

# ---- 初始化 admin 账户 ----
# 不要使用 admin123；登录用户名固定为 admin
ADMIN_PASSWORD=__CHANGE_ME_admin_password__
# 1 = backend 侧跳过 admin 创建（init 容器已用 ADMIN_PASSWORD 一次性建好）
BOOTSTRAP_TOKEN_ENABLED=1

# ---- 连接器/凭据加密密钥（生产必填）----
CONNECTOR_CONFIG_ENCRYPTION_KEY=__CHANGE_ME_connector_encryption_key__

# ---- CORS ----
CORS_ALLOWED_ORIGINS=https://itsm.example.com

# ---- LLM（AI 能力；留空则不启用 AI 相关能力）----
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_API_KEY=
LLM_ENDPOINT=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# AI 能力就绪申报（fail-closed：留空即视为未声明 ready）
ITSM_AI_READY=
ITSM_CMDB_DISCOVERY_READY=
ITSM_FEISHU_READY=
ITSM_WECOM_READY=
ITSM_DINGTALK_READY=

# sidecar 服务间令牌（X-Service-Token）；两端须一致，留空则不鉴权（启动告警）
AI_SERVICE_TOKEN=

# ---- SMTP（邮件工单闭环；留空则不发信）----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ---- 云交付凭据（env://ITSM_ALIYUN 在进程内解析；留空则不启用云交付）----
ITSM_ALIYUN_ACCESS_KEY_ID=
ITSM_ALIYUN_ACCESS_KEY_SECRET=

# ---- 监控（--profile monitoring 启用时必填 Grafana 密码）----
GRAFANA_ADMIN_PASSWORD=

# ---- 可选：Email-to-Ticket 演示/试用能力声明 ----
# 若想让 SaaS 租户试用邮件建单闭环，可在此注入演示模式（见 docker-compose.demo.yml）。
# 默认留空 = 观察模式（fail-closed，不自动建单）。
EMAIL_INTAKE_MODE=
EMAIL_INTAKE_AUTOMATION_REPORTER_ID=
EMAIL_INTAKE_DEFAULT_GROUP_ID=
