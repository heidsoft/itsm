{
  "name": "itsm-cli",
  "version": "1.0.0",
  "description": "ITSM Command-Line Interface built with Ink (React for CLI)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "itsm": "./bin/itsm.js",
    "itsm-mcp": "./bin/itsm-mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node bin/itsm.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "gen:enums": "node scripts/gen-enums.mjs",
    "check:enums": "node scripts/gen-enums.mjs --check",
    "check:route-drift": "npm run build && node scripts/check-route-drift.mjs",
    "check": "npm run typecheck && npm run check:enums && npm run check:route-drift && npm test",
    "smoke:agent": "node scripts/agent-smoke.mjs",
    "mcp": "npm run build && node bin/itsm-mcp.js",
    "smoke:mcp": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "got": "^14.0.0",
    "ink": "^6.2.0",
    "meow": "^14.0.0",
    "ora": "^9.0.0",
    "react": "^19.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.3.0"
  }
}
